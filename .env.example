# copy this file to .env and add the local database settings
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=auction_eight;charset=utf8mb4"
DB_USER="auction_app"
DB_PASSWORD="choose-a-local-password"
# log keeps emails local; smtp uses an email server to send them
MAIL_TRANSPORT="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURITY="tls"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""

# use 1 when the website is served over HTTPS
APP_PUBLIC_HTTPS="0"
